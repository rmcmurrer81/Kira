{
  "name": "Kira FounderOps Gemini Demo",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "PORT": "8080",
    "GEMINI_MODEL": "gemini-3.6-flash",
    "FIRESTORE_ENABLED": "false"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Kira FounderOps live demo",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "cd gemini-xprize && pip install --no-cache-dir -r requirements.txt",
  "postStartCommand": "cd gemini-xprize && (pkill -f 'python app.py' || true); nohup python app.py >/tmp/kira-founderops.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
