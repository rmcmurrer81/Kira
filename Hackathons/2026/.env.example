# Copy to .env only on your own computer. Never commit the real .env file.

# AWS / Agents for Humans / CockroachDB x AWS
AWS_PROFILE=your-local-aws-profile
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=do-not-store-real-values-here
# AWS_SECRET_ACCESS_KEY=do-not-store-real-values-here

# Google Gemini / Google Cloud
GEMINI_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me
KIRA_TRUTHKEEPER_GEMINI_MODEL=gemini-3.5-flash
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# CockroachDB Cloud
DATABASE_URL=postgresql://username:password@host:26257/defaultdb?sslmode=verify-full

# CALL-E — use the exact key from the event/provider dashboard
CALLE_API_KEY=replace-me
CALLE_BASE_URL=https://api.heycall-e.com
